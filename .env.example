# Default: PostgreSQL + pgvector (docker compose up db)
OBS_DATABASE_URL=postgresql+psycopg2://observatory:observatory_dev_only@localhost:5432/observatory
# Local fallback without Docker:
# OBS_DATABASE_URL=sqlite:///artifacts/observatory.sqlite
OBS_ADMIN_API_KEY=change-me
# Embedding provider: baseline (offline, lexical) | sentence-transformers:<model-name>
OBS_EMBEDDING_PROVIDER=baseline
